# Backend Port
PORT=8081

# Tailscale Auth Key (optional, from https://login.tailscale.com/admin/settings/keys)
# If left blank, you can authenticate once via the login URL in: docker logs tabroom-tailscale
TS_AUTHKEY=

# Optional: Super Admin emails (comma-separated)
SUPER_ADMIN_EMAILS=

# Optional: Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID=
